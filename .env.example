# Copy to .env when deploying via docker compose, fill in real values.

# ── Public demo ──────────────────────────────────────────────────────

# Required: an API key for one of the supported cloud LLM backends.
# Common picks for a public demo (free tiers):
#   Gemini Flash  → https://aistudio.google.com/apikey
#   Groq          → https://console.groq.com/keys
OMAKASE_API_KEY=

# Optional: MyAnimeList Client ID (only if exposing MAL as a source).
# Get one at https://myanimelist.net/apiconfig
MAL_CLIENT_ID=

# ── Plus mode (private, workstation-only) ────────────────────────────

# Set to "true" to enable Plus routes (/plus/*). Default: false (public mode).
OMAKASE_PLUS_PRIVATE=false

# 32-byte hex key for encrypting stored secrets (AES-256-GCM).
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
OMAKASE_PLUS_MASTER_KEY=

# Seed account credentials (used by `python -m omakase.plus.admin seed-user`).
OMAKASE_SEED_EMAIL=
OMAKASE_SEED_PASSWORD=

# AniList OAuth app — register at https://anilist.co/settings/developer
ANILIST_CLIENT_ID=
ANILIST_CLIENT_SECRET=

# Overseerr instance (from Overseerr Settings → API).
OVERSEERR_URL=http://overseerr.lab:5055
OVERSEERR_API_KEY=

# Admin token for Plus admin CLI operations.
OMAKASE_PLUS_ADMIN_TOKEN=
