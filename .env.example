# Copy to .env when deploying via docker compose, fill in real values.

# Required: an API key for one of the supported cloud LLM backends.
# Common picks for a public demo (free tiers):
#   Gemini Flash  → https://aistudio.google.com/apikey
#   Groq          → https://console.groq.com/keys
OMAKASE_API_KEY=
# Optional in hosted mode: comma-separated HTTPS origins whose OpenWebUI
# instances visitors may select, for example https://models.example.com.
OMAKASE_OPENWEBUI_ALLOWED_ORIGINS=

# Optional: MyAnimeList Client ID (only if exposing MAL as a source).
# Get one at https://myanimelist.net/apiconfig
MAL_CLIENT_ID=
